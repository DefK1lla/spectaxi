{
  "alwaysUpdateLinks": true,
  "newFileLocation": "folder",
  "newFileFolderPath": "docs",
  "attachmentFolderPath": "docs/attachments",
  "showLineNumber": true,
  "strictLineBreaks": false,
  "readableLineLength": true,
  "defaultViewMode": "preview",
  "promptDelete": true,
  "trashOption": "local",
  "showUnsupportedFiles": false,
  "userIgnoreFilters": [
    "/^apps(\\/|$)/",
    "/^packages(\\/|$)/",
    "/^node_modules(\\/|$)/",
    "node_modules/",
    "**/node_modules/",
    "/^\\.git(\\/|$)/",
    "/^\\.github(\\/|$)/",
    "/^\\.husky(\\/|$)/",
    "/^\\.cursor(\\/|$)/",
    "/^\\.agents(\\/|$)/",
    "/^eslint(\\/|$)/",
    "/^coverage(\\/|$)/",
    "/^dist(\\/|$)/",
    "/^build(\\/|$)/",
    "/^\\.turbo(\\/|$)/",
    "/^\\.next(\\/|$)/",
    "/^\\.expo(\\/|$)/",
    "/.*\\.(ts|tsx|js|jsx|mjs|cjs|json|lock|yml|yaml|toml|css|scss|map|svg|png|jpg|ico|woff2?)$/"
  ]
}
