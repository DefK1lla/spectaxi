# Copy to .env and adjust. Do not commit real secrets.
# cp .env.example .env   (Windows: copy .env.example .env)

# --- apps/api ---
PORT=3000
# Liveness:  GET http://localhost:3000/api/v1/health
# Readiness: GET http://localhost:3000/api/v1/ready
# Metrics:   GET http://localhost:3000/api/v1/metrics
#   Header:  Authorization: Bearer <METRICS_TOKEN>
# OpenAPI:   http://localhost:3000/api/docs  (when ENABLE_OPENAPI=true)

# PostgreSQL via Neon (local/dev). Create a project at https://neon.tech,
# copy the connection string (sslmode=require), paste below, then uncomment.
# Do NOT put real personal data in Neon — servers are outside RF (see TECH_STACK).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Required for /api/v1/metrics (Grafana Cloud scrape / local curl).
METRICS_TOKEN=change-me-local-metrics-token

# Browser origins allowed to call the API (comma-separated). Default: localhost:3001/3002.
# After Vercel: https://your-admin.vercel.app,https://your-web.vercel.app
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Optional Sentry (API). If empty — Sentry is not initialized.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenAPI UI + JSON (dev only recommended).
# ENABLE_OPENAPI=true

# Optional later:
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET=
# OTP_DEV_CODE=1234

# S3-compatible object storage (Neon Object Storage / Cloudflare R2 / …).
# Neon console may show AWS_ENDPOINT_URL_S3 / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY —
# map them to S3_* below. Neon needs path-style addressing.
# S3_ENDPOINT=https://….storage…..neon.tech
# S3_KEY=
# S3_SECRET=
# S3_REGION=eu-central-1
# S3_BUCKET=assets
# S3_FORCE_PATH_STYLE=true
# Later (optional split): S3_BUCKET_PUBLIC= / S3_BUCKET_PRIVATE=


# --- apps/admin ---
# Dev server port is set in package script (3001).
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# --- apps/web ---
# Dev server port is set in package script (3002).
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# --- apps/mobile ---
# EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_SENTRY_DSN=
