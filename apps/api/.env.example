# Copy to apps/api/.env (Prisma 7 CLI loads dotenv via prisma.config.ts).
# You can keep the same values in the repo root .env for Nest.

PORT=3000

# Neon: https://neon.tech → project → Connection string
# Required for prisma migrate / studio and after enabling PrismaModule.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

METRICS_TOKEN=change-me-local-metrics-token

# CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# SENTRY_DSN=
# ENABLE_OPENAPI=true
