# Copy to apps/api/.env (Prisma 7 CLI loads dotenv via prisma.config.ts).
# You can keep the same values in the repo root .env for Nest.

PORT=3000

# Neon: https://neon.tech → project → Connection string
# Required for prisma migrate / studio and after enabling PrismaModule.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

METRICS_TOKEN=change-me-local-metrics-token

# CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# SENTRY_DSN=
# ENABLE_OPENAPI=true

# S3-compatible storage (Neon Object Storage / R2). Neon: forcePathStyle.
# Map from Neon AWS_ENDPOINT_URL_S3 / AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# S3_ENDPOINT=https://….storage…..neon.tech
# S3_KEY=
# S3_SECRET=
# S3_REGION=eu-central-1
# S3_BUCKET=assets
# S3_FORCE_PATH_STYLE=true

