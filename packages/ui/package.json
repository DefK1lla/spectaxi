{
  "name": "@spectaxi/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tamagui.config": "./src/tamagui.config.ts"
  },
  "scripts": {
    "generate:css": "node ./scripts/generate-theme-css.mjs && pnpm -w exec prettier --write packages/ui/src/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint yet\""
  },
  "dependencies": {
    "@spectaxi/theme": "workspace:*",
    "@tamagui/config": "3.2.4",
    "tamagui": "3.2.4"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "5.9.3"
  }
}
